# Firebase Client (optional; PII goes through API + Admin SDK)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin — BẮT BUỘC trên Vercel để import/search hoạt động
# Dán NGUYÊN nội dung file JSON (một dòng hoặc multi-line đều được)
FIREBASE_SERVICE_ACCOUNT_KEY=

# Hoặc tách 3 biến (nếu không dùng JSON một biến):
# FIREBASE_ADMIN_PROJECT_ID=thongtinsinhvien-39330
# FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@thongtinsinhvien-39330.iam.gserviceaccount.com
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Sessions (ADMIN_PASSWORD mặc định admin123 nếu không set)
# SESSION_SECRET nên set trên Vercel; nếu thiếu sẽ fallback tự động
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_PASSWORD=admin123
STUDENT_SESSION_HOURS=4

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
